# Editores
/.idea/
/.vscode/
*.swp

# Datos en tiempo de ejecución: NUNCA deben versionarse.
# Las sesiones contienen datos de usuarios conectados y los logs pueden
# contener rutas internas y detalles de errores.
/storage/sessions/*
/storage/logs/*
!/storage/sessions/.gitignore
!/storage/logs/.gitignore

# Respaldos y volcados de base de datos: contienen las ventas reales del
# negocio. Se guardan aparte, nunca en el repositorio.
/RESPALDOS/
/PARA-EL-SERVIDOR/
*.sql.gz

# Credenciales locales
.env
.env.*
!.env.example

# Sistema operativo
Thumbs.db
desktop.ini
.DS_Store
